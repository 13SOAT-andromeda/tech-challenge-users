# Database (usersdb — shared with Lambda user-authentication)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=usersdb
DB_SSLMODE=disable
DB_TIMEZONE=America/Sao_Paulo

# HTTP
HTTP_PORT=8081
HTTP_ALLOWED_ORIGINS=*

# Admin bootstrap (idempotent on startup)
ADMIN_EMAIL=admin@garage.com
ADMIN_PASSWORD=Admin@123
ADMIN_DOCUMENT=00000000000

# Observability — Datadog
DD_AGENT_HOST=datadog-agent
DD_SERVICE=tech-challenge-users
DD_SITE=datadoghq.com
DD_API_KEY=
DD_VERSION=v1
API_VERSION=v1

# Environment
ENV=development
